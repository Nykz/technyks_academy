API_PORT=3000
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/technyks_academy"
ALLOW_IN_MEMORY_FALLBACK=false
UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads
# Store paid ZIPs outside the public web folder. Use a persistent absolute path in production.
PRIVATE_UPLOADS_DIR=./private_uploads/templates
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-one-time-bootstrap-password
JWT_SECRET="replace-with-a-long-random-secret"
# Bunny Stream: copy the Library ID from Stream > your library > API.
# Copy the embed/token authentication key from that library's Security page.
# Keep real keys only in .env or your host's secret manager; never commit them.
BUNNY_STREAM_ENABLED=false
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_KEY=""
# Used only by the protected server-side bulk uploader; never expose this in Angular/browser code.
BUNNY_STREAM_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CORS_ORIGINS="https://courses.codingtechnyks.com"
WEB_APP_URL="https://courses.codingtechnyks.com"
RESEND_API_KEY=""
MAIL_FROM="Technyks Academy <support@codingtechnyks.com>"
MAIL_REPLY_TO="support@codingtechnyks.com"
LEMON_SQUEEZY_API_KEY=""
